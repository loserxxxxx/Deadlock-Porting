{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Deadlock Porting",
  "version": "0.10.13",
  "identifier": "com.deadlockporting.desktop",
  "build": { "frontendDist": "../frontend" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "label": "main", "title": "Deadlock Porting", "width": 1320, "height": 900, "minWidth": 900, "minHeight": 650, "backgroundColor": "#52637b", "decorations": false }],
    "security": { "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'" }
  },
  "bundle": { "active": false, "icon": ["icons/deadlock-glass.ico"] }
}
